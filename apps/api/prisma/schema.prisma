generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id               String     @id @default(uuid())
  name             String
  contact          String?
  address          String?
  currency         String
  taxConfiguration Json?
  settings         Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  branches         Branch[]
  users            User[]
  devices          Device[]
  products         Product[]
  categories       Category[]

  @@map("businesses")
}

model Branch {
  id         String       @id @default(uuid())
  businessId String
  name       String
  address    String?
  status     EntityStatus @default(ACTIVE)
  settings   Json?

  business   Business     @relation(fields: [businessId], references: [id])
  users      User[]
  devices    Device[]

  @@index([businessId])
  @@map("branches")
}

model User {
  id         String       @id @default(uuid())
  businessId String
  branchId   String?
  name       String
  email      String?
  phone      String?
  role       UserRole
  status     EntityStatus @default(ACTIVE)

  business   Business     @relation(fields: [businessId], references: [id])
  branch     Branch?      @relation(fields: [branchId], references: [id])

  @@index([businessId])
  @@index([branchId])
  @@map("users")
}

model Device {
  id             String         @id @default(uuid())
  businessId     String
  branchId       String?
  platform       DevicePlatform
  type           DeviceType
  deploymentMode DeploymentMode
  status         EntityStatus   @default(ACTIVE)
  lastSyncAt     DateTime?
  configuration  Json?

  business       Business       @relation(fields: [businessId], references: [id])
  branch         Branch?        @relation(fields: [branchId], references: [id])

  @@index([businessId])
  @@index([branchId])
  @@map("devices")
}

model Product {
  id           String       @id @default(uuid())
  businessId   String
  name         String
  sku          String?
  barcode      String?
  categoryId   String?
  brand        String?
  costPrice    Decimal      @db.Decimal(12, 2)
  sellingPrice Decimal      @db.Decimal(12, 2)
  tax          Decimal?     @db.Decimal(12, 2)
  unit         String?
  image        String?
  status       EntityStatus @default(ACTIVE)

  business     Business     @relation(fields: [businessId], references: [id])
  category     Category?    @relation(fields: [categoryId], references: [id])

  @@index([businessId])
  @@index([categoryId])
  @@index([barcode])
  @@index([sku])
  @@map("products")
}

model Category {
  id         String       @id @default(uuid())
  businessId String
  name       String
  parentId   String?
  status     EntityStatus @default(ACTIVE)

  business   Business     @relation(fields: [businessId], references: [id])
  parent     Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   Category[]   @relation("CategoryHierarchy")
  products   Product[]

  @@index([businessId])
  @@index([parentId])
  @@map("categories")
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  INVENTORY_MANAGER
}

enum DevicePlatform {
  WINDOWS
  MACOS
  LINUX
  UBUNTU
  ANDROID
  IOS
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  OTHER
}

enum DeploymentMode {
  LOCAL
  CLOUD
  HYBRID
}