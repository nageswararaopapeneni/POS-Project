generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  sales    Sale[]
  receipts Receipt[]
  users    User[]
  reconciliations Reconciliation[]

  @@index([name])
}

model User {
  id           String   @id @default(uuid())
  businessId   String
  branchId     String?
  userId       String
  name         String
  role         String
  status       String   @default("active")
  passwordHash String?
  pinHash      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([businessId, status])
}

model Product {
  id         String   @id @default(uuid())
  businessId String
  name       String
  sku        String?
  barcode    String?
  price      Decimal  @db.Decimal(12, 2)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  items    SaleItem[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([businessId, name])
}

model Sale {
  id         String   @id @default(uuid())
  businessId String
  branchId   String?
  status     String
  subtotal   Decimal  @db.Decimal(12, 2)
  discount   Decimal  @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  items    SaleItem[]
  payments Payment[]
  receipt  Receipt?

  @@index([businessId])
  @@index([businessId, createdAt])
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  productId String
  quantity  Decimal  @db.Decimal(12, 3)
  unitPrice Decimal  @db.Decimal(12, 2)
  lineTotal Decimal  @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id          String   @id @default(uuid())
  businessId  String
  saleId      String
  amount      Decimal  @db.Decimal(12, 2)
  method      String
  status      String
  reference   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([businessId])
  @@index([saleId])
}

model Receipt {
  id            String   @id @default(uuid())
  businessId    String
  saleId        String   @unique
  receiptNumber String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  sale     Sale     @relation(fields: [saleId], references: [id])

  @@unique([businessId, receiptNumber])
  @@index([businessId])
  @@index([businessId, receiptNumber])
}

model Reconciliation {
  id             String   @id @default(uuid())
  businessId     String
  businessDate   DateTime @db.Date
  totalSales     Decimal  @db.Decimal(12, 2)
  cashTotal      Decimal  @db.Decimal(12, 2)
  upiTotal       Decimal  @db.Decimal(12, 2)
  cardTotal      Decimal  @db.Decimal(12, 2)
  otherTotal     Decimal  @db.Decimal(12, 2)
  expectedCash   Decimal  @db.Decimal(12, 2)
  actualCash     Decimal  @db.Decimal(12, 2)
  cashDifference Decimal  @db.Decimal(12, 2)
  status         String
  closedBy       String?
  closedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, businessDate])
  @@index([businessId])
  @@index([businessId, businessDate])
}